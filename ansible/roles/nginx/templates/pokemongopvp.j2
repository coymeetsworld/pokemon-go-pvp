server {
    server_name pokemongopvp.com www.pokemongopvp.com;

    location /static/ {
        alias /opt/pvpoke/app/static/;
    }

    location / {
        proxy_pass http://unix:/opt/pvpoke/app/pvpoke.sock;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/pokemongopvp.com/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/pokemongopvp.com/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}


server {
    if ($host = www.pokemongopvp.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    if ($host = pokemongopvp.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    server_name pokemongopvp.com www.pokemongopvp.com;
    return 404; # managed by Certbot
}